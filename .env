# ── NVIDIA NIM / Build API ──────────────────────────────────────────────────
# Get your free key at: https://build.nvidia.com  → "Get API Key"
NVIDIA_API_KEY="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"

# NVIDIA Voice settings (primary TTS provider when NVIDIA_API_KEY is set)
# Magpie Multilingual TTS voices: Aria (EN), Marco (ES), Sophie (FR), etc.
NVIDIA_TTS_VOICE="Magpie-Multilingual.EN-US.Aria"
NVIDIA_TTS_LANGUAGE="en-US"
NVIDIA_TTS_SAMPLE_RATE="44100"
NVIDIA_VOICE_ENABLED="true"

# Chatterbox TTS (Resemble.AI on NVIDIA NIM) — most human-sounding voice, tried first
# Endpoint: https://integrate.api.nvidia.com/v1
NVIDIA_CHATTERBOX_ENABLED="true"
# Voice expressiveness: 0=flat, 1=natural human, >1=theatrical. 0.9 = warm & clear.
NVIDIA_TTS_EXAGGERATION="0.9"
# Guidance scale: how closely to match the reference voice. 3 = balanced & natural.
NVIDIA_TTS_CFG_WEIGHT="3"
